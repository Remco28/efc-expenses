{
  "name": "efc-expenses",
  "version": "0.1.0",
  "description": "Track and split shared costs on fencing club travel tournaments",
  "scripts": {
    "vendor": "mkdir -p public/vendor && cp node_modules/pdf-lib/dist/pdf-lib.min.js public/vendor/",
    "dev": "npm run vendor && wrangler dev",
    "deploy": "npm run vendor && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply efc-expenses --local",
    "db:migrate": "wrangler d1 migrations apply efc-expenses --remote",
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  },
  "private": true
}
