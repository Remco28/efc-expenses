{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "efc-expenses",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "efc-expenses",
			"database_id": "ec0fcfbd-81f0-4c99-a438-ffd8eaf98099",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "RECEIPTS",
			"bucket_name": "efc-expenses-receipts"
		}
	],
	"routes": [
		{
			"pattern": "efcexpenses.teamremco.org",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
